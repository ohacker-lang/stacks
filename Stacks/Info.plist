<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Xcode's generated Info.plist only includes INFOPLIST_KEY_ settings for keys
  Apple recognizes, so these app settings were silently dropped and the app
  always fell back to demo services. Xcode merges this file with the generated
  one; values come from the INFOPLIST_KEY_STACKS_* build settings per
  configuration.
-->
<plist version="1.0">
<dict>
	<key>STACKS_SUPABASE_URL</key>
	<string>$(INFOPLIST_KEY_STACKS_SUPABASE_URL)</string>
	<key>STACKS_SUPABASE_ANON_KEY</key>
	<string>$(INFOPLIST_KEY_STACKS_SUPABASE_ANON_KEY)</string>
	<key>STACKS_PRODUCT_SEARCH_URL</key>
	<string>$(INFOPLIST_KEY_STACKS_PRODUCT_SEARCH_URL)</string>
	<key>STACKS_REVENUECAT_API_KEY</key>
	<string>$(INFOPLIST_KEY_STACKS_REVENUECAT_API_KEY)</string>
	<key>STACKS_POSTHOG_API_KEY</key>
	<string>$(INFOPLIST_KEY_STACKS_POSTHOG_API_KEY)</string>
	<key>STACKS_POSTHOG_HOST</key>
	<string>$(INFOPLIST_KEY_STACKS_POSTHOG_HOST)</string>
</dict>
</plist>
